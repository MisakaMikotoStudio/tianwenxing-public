{
  "name": "dsh-tianwen-star",
  "version": "0.1.0",
  "description": "天问星：DeepSeek Harness 商务沟通模拟插件——面试与商务洽谈的攻略、角色扮演、科学评估与内心想法复盘",
  "license": "MIT",
  "homepage": "https://tianwenxing.yuban.site",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MisakaMikotoStudio/tianwenxing-public.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./coach": {
      "types": "./lib/coach.d.ts",
      "default": "./lib/coach.js"
    },
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "client/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepare": "tsc -p tsconfig.build.json"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.4 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.4 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.4 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.4 <0.3.0",
    "@deepseek-ai/dsh-session-projection": ">=0.2.2-rc.4 <0.3.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.2-rc.4 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.4 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
